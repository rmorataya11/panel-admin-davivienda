# Cliente web de Identity Platform (Firebase). Mismo proyecto que el portal.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud SQL. Mismas variables que el portal.
# INSTANCE_CONNECTION_NAME tiene la forma PROYECTO:REGION:INSTANCIA.
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=
# PUBLIC (por defecto), PRIVATE o PSC.
DB_IP_TYPE=
# Ruta local al JSON de la cuenta de servicio.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternativa al archivo: el mismo JSON codificado en base64.
GOOGLE_CREDENTIALS_BASE64=

# Correos autorizados para entrar al panel, separados por coma.
ADMIN_ALLOWED_EMAILS=
